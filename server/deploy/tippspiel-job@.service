[Unit]
Description=NFL Tippspiel job %i
Documentation=https://github.com/Fidge123/tippspiel/blob/master/server/deploy/README.md
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=tippspiel
Group=tippspiel
WorkingDirectory=/srv/tippspiel/server
EnvironmentFile=/etc/tippspiel/server.env
Environment=BACKUP_DIR=/srv/tippspiel/backup
ExecStart=/usr/local/bin/bun run src/jobs/cli.ts %i
MemoryMax=256M
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/tippspiel/backup
