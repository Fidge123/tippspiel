{
  "name": "server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun run src/index.tsx",
    "dev": "bun --watch src/index.tsx",
    "build:css": "tailwindcss -i styles/app.css -o static/app.css --minify",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "hono": "^4.10.4",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@tailwindcss/cli": "^4.2.5",
    "@types/bun": "^1.3.11",
    "@types/pg": "^8.15.5",
    "tailwindcss": "^4.2.5",
    "typescript": "^5.3.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
