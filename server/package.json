{
  "name": "server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun run src/index.tsx",
    "dev": "bun --watch src/index.tsx",
    "migrate": "bun run src/db/migrate.ts",
    "build:css": "tailwindcss -i styles/app.css -o static/app.css --minify",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run -c vitest.config.integration.ts",
    "test:replay": "vitest run -c vitest.config.replay.ts",
    "test:delivery": "vitest run -c vitest.config.delivery.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1130.0",
    "@hono/zod-validator": "^0.9.1",
    "hono": "^4.10.4",
    "kysely": "^0.29.5",
    "pg": "^8.23.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@tailwindcss/cli": "^4.2.5",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/bun": "^1.3.11",
    "@types/pg": "^8.15.5",
    "@types/pg-copy-streams": "^1.2.5",
    "pg-copy-streams": "^7.0.0",
    "tailwindcss": "^4.2.5",
    "typescript": "^5.3.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
